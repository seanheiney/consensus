{
  "name": "consensus-panel",
  "version": "0.3.0",
  "description": "A panel of frontier models debates your hardest question until it agrees, and reports what it could not settle. Runs on the subscriptions you already have. CLI, MCP server, GitHub Action, library.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "consensus": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "packs",
    "docs/*.md",
    "README.md",
    "PACKS.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "scripts",
    "suites",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-info.mjs",
    "bundle": "node scripts/bundle.mjs",
    "package": "node scripts/package.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "ci": "pnpm typecheck && pnpm test && pnpm build && npm pack --dry-run"
  },
  "keywords": [
    "llm",
    "consensus",
    "multi-model",
    "debate",
    "mcp",
    "claude",
    "openai",
    "grok",
    "gemini",
    "agentic",
    "github-action",
    "prompt-injection",
    "llm-evaluation",
    "groq",
    "ai-agents"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@clack/prompts": "^1.8.1",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "openai": "^7.15.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanheiney/consensus.git"
  },
  "homepage": "https://github.com/seanheiney/consensus#readme",
  "bugs": {
    "url": "https://github.com/seanheiney/consensus/issues"
  },
  "author": "Sean Heiney"
}
